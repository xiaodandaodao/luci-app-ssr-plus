+-- ---------------------------------------------------------------------------
+-- Mihomo url-test 自动选择器
+--
+-- 订阅/上传的 Clash YAML 里，代理组通常是 type: select，选哪个节点全靠手点。
+-- 开启后，为每个「叶子组」（成员全是真实节点的 select 组）生成一个 url-test 孪生组，
+-- 并把它插到原组成员的第 1 位 —— 和主流订阅模板的做法一致：
+-- 默认选中第 1 项即「自动选最快」，用户仍可在面板里手动改回具体节点。
+-- ---------------------------------------------------------------------------
+
+local URLTEST_DEFAULT_URL = "https://www.gstatic.com/generate_204"
+
+local function uci_subscribe_option(option, default)
+	local value = uci:get_first("shadowsocksr", "server_subscribe", option)
+	if value == nil or value == "" then
+		return default
+	end
+	return value
+end
+
+local function get_urltest_options()
+	if tostring(uci_subscribe_option("mihomo_urltest", "0")) ~= "1" then
+		return nil
+	end
+
+	local url = tostring(uci_subscribe_option("mihomo_urltest_url", ""))
+	if url == "" then
+		url = tostring(uci_subscribe_option("url_test_url", ""))
+	end
+	if url == "" then
+		url = URLTEST_DEFAULT_URL
+	end
+
+	local interval = tonumber(uci_subscribe_option("mihomo_urltest_interval", "300")) or 300
+	if interval < 30 then
+		interval = 30
+	end
+
+	local tolerance = tonumber(uci_subscribe_option("mihomo_urltest_tolerance", "50")) or 50
+	if tolerance < 0 then
+		tolerance = 0
+	end
+
+	return { url = url, interval = interval, tolerance = tolerance }
+end
+
+local function collect_proxy_names(doc)
+	local names = {}
+	for _, proxy in ipairs(doc.proxies or {}) do
+		if type(proxy) == "table" then
+			local name = tostring(proxy.name or "")
+			if name ~= "" then
+				names[name] = true
+			end
+		end
+	end
+	return names
+end
+
+local function collect_group_types(doc)
+	local types = {}
+	for _, group in ipairs(doc["proxy-groups"] or {}) do
+		if type(group) == "table" then
+			local name = tostring(group.name or "")
+			if name ~= "" then
+				types[name] = tostring(group.type or ""):lower()
+			end
+		end
+	end
+	return types
+end
+
+local function collect_used_names(doc)
+	local used = {}
+	for name in pairs(collect_proxy_names(doc)) do
+		used[name] = true
+	end
+	for name in pairs(collect_group_types(doc)) do
+		used[name] = true
+	end
+	return used
+end
+
+local function make_auto_group_name(base, used)
+	local name = base .. " 自动选择"
+	if not used[name] then
+		used[name] = true
+		return name
+	end
+	local index = 2
+	while used[base .. " 自动选择 " .. index] do
+		index = index + 1
+	end
+	name = base .. " 自动选择 " .. index
+	used[name] = true
+	return name
+end
+
+-- 只有「叶子组」才注入：成员必须全是真实节点，且组内尚未出现 url-test/fallback 成员
+-- （后者保证重复执行不会叠加，同时也尊重订阅模板自带的自动选择组）。
+local function urltest_candidate(group, proxy_names, group_types)
+	if tostring(group.type or ""):lower() ~= "select" then
+		return nil
+	end
+	if has_nonempty_sequence(group.use) then
+		return nil
+	end
+
+	local members = group.proxies
+	if type(members) ~= "table" or #members < 2 then
+		return nil
+	end
+
+	for _, member in ipairs(members) do
+		local name = tostring(member or "")
+		local gtype = group_types[name]
+		if gtype == "url-test" or gtype == "fallback" or gtype == "load-balance" then
+			return nil
+		end
+		if not proxy_names[name] then
+			return nil
+		end
+	end
+
+	return members
+end
+
+local function inject_urltest_groups(doc)
+	local options = get_urltest_options()
+	if not options then
+		return 0
+	end
+
+	local groups = doc["proxy-groups"]
+	if type(groups) ~= "table" or #groups == 0 then
+		return 0
+	end
+
+	local proxy_names = collect_proxy_names(doc)
+	local group_types = collect_group_types(doc)
+	local used = collect_used_names(doc)
+
+	local result = {}
+	local added = 0
+
+	for _, group in ipairs(groups) do
+		if type(group) ~= "table" then
+			result[#result + 1] = group
+		else
+			local members = urltest_candidate(group, proxy_names, group_types)
+			if members then
+				local name = make_auto_group_name(tostring(group.name or "Proxy"), used)
+				-- 拷贝一份，避免和原组共享同一张表导致 lyaml 输出 YAML 锚点/别名
+				local copied = {}
+				for index, member in ipairs(members) do
+					copied[index] = member
+				end
+
+				result[#result + 1] = {
+					name = name,
+					type = "url-test",
+					url = options.url,
+					interval = options.interval,
+					tolerance = options.tolerance,
+					proxies = copied
+				}
+				table.insert(group.proxies, 1, name)
+				group_types[name] = "url-test"
+				added = added + 1
+			end
+			result[#result + 1] = group
+		end
+	end
+
+	if added > 0 then
+		doc["proxy-groups"] = result
+	end
+
+	return added
+end
+
 local function strip_incompatible_script_rules(doc)
 	local kept = {}
 	local removed = 0
@@ -322,6 +502,7 @@ local function merge(raw_path, overlay_path, output_path)
 	strip_runtime_conflicts(raw_doc)
 	local filled_groups = fill_empty_proxy_groups(raw_doc)
 	local stripped_rules = strip_incompatible_script_rules(raw_doc)
+	local injected_urltest = inject_urltest_groups(raw_doc)
 	local merged = deep_merge(raw_doc, overlay_doc)
 	local ok, rendered = pcall(lyaml.dump, { merged })
 	if not ok or not rendered then
@@ -330,7 +511,8 @@ local function merge(raw_path, overlay_path, output_path)
 	end
 
 	write_file(output_path, rendered)
-	io.stdout:write(string.format("filled_groups=%d stripped_script_rules=%d\n", filled_groups, stripped_rules))
+	io.stdout:write(string.format("filled_groups=%d stripped_script_rules=%d injected_urltest=%d\n",
+		filled_groups, stripped_rules, injected_urltest))
 	return true
 end
 
