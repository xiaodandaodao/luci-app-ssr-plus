+		expand:      '<%:Expand%>',
+		collapse:    '<%:Collapse%>',
+		switchTo:    '<%:Switch to this node%>',
+		fastest:     '<%:Fastest:%>',
+		emptyTitle:  '<%:No switchable proxy groups found.%>',
+
+		autoRegionOffHint: '<%:Turn on "Mihomo Smart Grouping and Auto Select" on the Servers page first.%>'
+	};
+
+	var TRANSLATE = {
+		'Selector': '<%:Selector%>',
+		'Direct': '<%:Direct%>',
+		'DIRECT': '<%:Direct%>',
+		'Reject': '<%:Reject%>',
+		'REJECT': '<%:Reject%>',
+		'Proxy': '<%:Proxy%>',
+		'Domestic': '<%:Domestic%>',
+		'GlobalTV': '<%:GlobalTV%>',
+		'AsianTV': '<%:AsianTV%>',
+		'Others': '<%:Others%>',
+		'GLOBAL': '<%:GLOBAL%>',
+		'url-test': '<%:url-test%>',
+		'URLTest': '<%:url-test%>',
+		'fallback': '<%:fallback%>',
+		'Fallback': '<%:fallback%>',
+		'load-balance': '<%:load-balance%>',
+		'LoadBalance': '<%:load-balance%>',
+		'relay': '<%:relay%>',
+		'Compatible': '<%:Compatible%>',
+		'Pass': '<%:Pass%>'
+	};
+
+	var COLLAPSE_AT = 12;
+	var PREVIEW_N = 6;
+
+	var ICONS = {
+		chevron: '<polyline points="6 9 12 15 18 9"/>',
+		bolt: '<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/>',
+		refresh: '<path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1"/><path d="M21 4v5h-5"/>',
+		search: '<circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-3.6-3.6"/>',
+		check: '<polyline points="20 6 9 17 4 12"/>',
+		inbox: '<path d="M3 13h4l1.5 3h7L17 13h4"/><path d="M5 5h14l2 8v6H3v-6z"/>',
+		group: '<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>'
+	};
+
+	// ------------------------------------------------------------------ 工具
+
+	function el(tag, cls, text) {
+		var node = document.createElement(tag);
+		if (cls) {
+			node.className = cls;
+		}
+		if (text !== undefined && text !== null) {
+			node.textContent = String(text);
+		}
+		return node;
+	}
+
+	function icon(name) {
+		var span = el('span', 'scui-icon');
+		span.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + ICONS[name] + '</svg>';
+		return span;
+	}
+
+	// 带 %d 的模板串做整型替换
+	function tpl(str, value) {
+		return String(str).replace('%d', value);
+	}
+
+	function translateName(name) {
+		return TRANSLATE[name] || name;
+	}
+
+	function toNumber(ms) {
+		var n = Number(ms);
+		if (ms === null || ms === undefined || ms === false || !isFinite(n) || n <= 0) {
+			return null;
+		}
+		return n;
+	}
+
+	function formatDelay(ms) {
+		var n = toNumber(ms);
+		if (n === null) {
+			return null;
+		}
+		if (n >= 1000) {
+			return (n / 1000).toFixed(2) + ' s';
+		}
+		return Math.round(n) + ' ms';
+	}
+
+	function delayClass(ms) {
+		var n = toNumber(ms);
+		if (n === null) {
+			return 'd-none';
+		}
+		if (n < 200) return 'd-fast';
+		if (n < 500) return 'd-ok';
+		if (n < 1000) return 'd-slow';
+		return 'd-bad';
+	}
+
+	function delayPill(ms) {
+		var pill = el('span', 'scui-pill ' + delayClass(ms));
+		pill.textContent = formatDelay(ms) || TEXT.timeout;
+		return pill;
+	}
+
+	function memberDelay(member) {
+		if (!member) {
+			return null;
+		}
+		return member.auto ? member.leaf_delay : member.delay;
+	}
+
+	function memberLabel(member) {
+		if (member && member.auto && member.leaf && member.leaf !== member.name) {
+			return translateName(member.name) + ' → ' + translateName(member.leaf);
+		}
+		return translateName(member ? member.name : '');
+	}
+
+	function sortMembers(members) {
+		return (members || []).slice().sort(function(a, b) {
+			var av = toNumber(a && (a.auto ? a.leaf_delay : a.delay));
+			var bv = toNumber(b && (b.auto ? b.leaf_delay : b.delay));
+			av = av === null ? Infinity : av;
+			bv = bv === null ? Infinity : bv;
+			if (av === bv) {
+				return String(a && a.name).localeCompare(String(b && b.name));
+			}
+			return av - bv;
+		});
+	}
+
+	function findMember(group, name) {
+		var found = null;
+		(group.members || []).forEach(function(item) {
+			if (item && item.name === name) {
+				found = item;
+			}
+		});
+		if (!found) {
+			// 兜底：根据名字推一个空壳成员
+			var leaf = null;
+			return { name: name, delay: null, leaf: leaf, leaf_delay: null, auto: false, is_group: false };
+		}
+		return found;
+	}
+
+	// ------------------------------------------------------------------ 组件
+
+	function create(opts) {
+		opts = opts || {};
+		var mount = opts.mount;
+		var statusEl = opts.statusEl || null;
+		var xhr = opts.xhr || window.ssrXHR || window.XHR;
+		var urls = opts.urls || {};
+		var sid = opts.sid || '';
+		var testing = false;
+		var groups = [];
+		var testUrl = '';
+		var testInterval = '';
+		var filterText = '';
+		var expandedGroups = {};
+
+		if (!mount) {
+			return null;
+		}
+
+		// ---- 状态区
+		function setStatus(text, tone) {
+			if (!statusEl) {
+				return;
+			}
+			statusEl.textContent = text || '';
+			statusEl.className = 'scui-status' + (tone ? ' t-' + tone : '');
+			if (tone && tone.charAt(0) === '#') {
+				statusEl.className = 'scui-status';
+				statusEl.style.color = tone;
+			} else {
+				statusEl.style.color = '';
+			}
+		}
+
+		function ok(text) { setStatus(text || TEXT.ready, 'ok'); }
+		function busy(text) { setStatus(text, 'busy'); }
+		function warn(text) { setStatus(text, 'warn'); }
+		function err(text) { setStatus(text, 'err'); }
+
+		// ---- 工具条
+		function buildToolbar() {
+			var bar = el('div', 'scui-toolbar');
+
+			var left = el('div', 'scui-toolbar-l');
+			var testAllBtn = el('button', 'scui-btn scui-btn-primary');
+			testAllBtn.type = 'button';
+			testAllBtn.appendChild(icon('bolt'));
+			testAllBtn.appendChild(el('span', null, TEXT.testAll));
+			testAllBtn.onclick = function() {
+				testAll(groups, testAllBtn);
+			};
+			left.appendChild(testAllBtn);
+
+			var refreshBtn = el('button', 'scui-btn');
+			refreshBtn.type = 'button';
+			refreshBtn.appendChild(icon('refresh'));
+			refreshBtn.appendChild(el('span', null, TEXT.refresh));
+			refreshBtn.onclick = function() { load(); };
+			left.appendChild(refreshBtn);
+
+			var search = el('span', 'scui-search');
+			search.appendChild(icon('search'));
+			var input = el('input');
+			input.type = 'text';
+			input.placeholder = TEXT.filterPh;
+			input.value = filterText;
+			input.oninput = function() {
+				filterText = input.value;
+				paint();
+			};
+			search.appendChild(input);
+			left.appendChild(search);
+			bar.appendChild(left);
+
+			var right = el('div', 'scui-toolbar-r');
+			var meta = el('div', 'scui-meta');
+			var totalNodes = 0;
+			groups.forEach(function(g) { totalNodes += (g.all || []).length; });
+
+			var gStat = el('span');
+			gStat.appendChild(el('b', null, groups.length));
+			gStat.appendChild(document.createTextNode(' ' + TEXT.groupsUnit));
+			meta.appendChild(gStat);
+
+			meta.appendChild(el('span', 'scui-meta-sep'));
+
+			var nStat = el('span');
+			nStat.appendChild(el('b', null, totalNodes));
+			nStat.appendChild(document.createTextNode(' ' + TEXT.nodesUnit));
+			meta.appendChild(nStat);
+
+			if (testUrl || testInterval) {
+				meta.appendChild(el('span', 'scui-meta-sep'));
+				var info = el('span', 'scui-meta-url');
+				var parts = [];
+				if (testUrl) { parts.push(testUrl); }
+				if (testInterval) { parts.push(testInterval + 's'); }
+				info.textContent = parts.join('  ·  ');
+				info.title = info.textContent;
+				meta.appendChild(info);
+			}
+			right.appendChild(meta);
+			bar.appendChild(right);
+
+			return bar;
+		}
+
+		// ---- 单个策略组卡片
+		function buildCard(group) {
+			var card = el('section', 'scui-card');
+			var nowName = group.now || group.resolved || '';
+			var nowMember = nowName ? findMember(group, nowName) : null;
+			var nowDelay = nowMember ? memberDelay(nowMember) : group.delay;
+			var expanded = expandedGroups[group.name] || false;
+			var isCollapsed = expandedGroups['__collapsed__' + group.name] === true;
+
+			if (isCollapsed) {
+				card.className += ' is-collapsed';
+			}
+
+			// ---------- 头部
+			var head = el('div', 'scui-card-head');
+
+			var title = el('button', 'scui-card-title');
+			title.type = 'button';
+			title.title = isCollapsed ? TEXT.expand : TEXT.collapse;
+			title.appendChild(icon('chevron'));
+			title.appendChild(el('span', 'scui-card-name', translateName(group.name)));
+			if (group.type) {
+				title.appendChild(el('span', 'scui-badge', translateName(group.type)));
+			}
+			title.onclick = function() {
+				var collapsed = expandedGroups['__collapsed__' + group.name] === true;
+				expandedGroups['__collapsed__' + group.name] = !collapsed;
+				paint();
+			};
+			head.appendChild(title);
+
+			var headR = el('div', 'scui-card-head-r');
+			if (nowName) {
+				headR.appendChild(delayPill(nowDelay));
+			}
+
+			var testBtn = el('button', 'scui-btn scui-btn-ghost');
+			testBtn.type = 'button';
+			testBtn.title = TEXT.speedTest;
+			testBtn.appendChild(icon('bolt'));
+			testBtn.appendChild(el('span', null, TEXT.speedTest));
+			testBtn.onclick = function() {
+				testBtn.disabled = true;
+				var ic = testBtn.querySelector('.scui-icon');
+				if (ic) { ic.style.animation = 'scui-spin 0.9s linear infinite'; }
+				runDelayTest(group.name, function(success) {
+					testBtn.disabled = false;
+					if (ic) { ic.style.animation = ''; }
+					if (success) {
+						ok();
+						load();
+					}
+				});
+			};
+			headR.appendChild(testBtn);
+			head.appendChild(headR);
+			card.appendChild(head);
+
+			// ---------- 主体
+			var body = el('div', 'scui-card-body');
+
+			var select = el('select', 'scui-select');
+			(group.all || []).forEach(function(name) {
+				var option = document.createElement('option');
+				option.value = name;
+				var member = findMember(group, name);
+				var label = translateName(name);
+				var d = formatDelay(memberDelay(member));
+				option.textContent = d ? (label + '  ·  ' + d) : label;
+				if (name === group.now) {
+					option.selected = true;
+				}
+				select.appendChild(option);
+			});
+			select.onchange = function() {
+				busy(TEXT.switching);
+				if (xhr && urls.switch) {
+					xhr.get(urls.switch, { sid: sid, group: group.name, name: select.value }, function(x, result) {
+						if (result && result.success) {
+							ok(TEXT.switched);
+							load();
+						} else {
+							err(TEXT.switchFail);
+							select.value = group.now || select.value;
+						}
+					});
+				}
+			};
+			body.appendChild(select);
+
+			// 当前 / 实际出口
+			var facts = el('div', 'scui-facts');
+			var curFact = el('span', 'scui-fact');
+			curFact.appendChild(el('span', 'scui-fact-key', (group.auto ? TEXT.autoSel : TEXT.current)));
+			curFact.appendChild(el('span', 'scui-fact-node', translateName(group.now || '—')));
+			if (nowDelay) {
+				curFact.appendChild(delayPill(nowDelay));
+			}
+			facts.appendChild(curFact);
+
+			if (group.resolved && group.resolved !== group.now) {
+				facts.appendChild(el('span', 'scui-arrow', '→'));
+				var exitFact = el('span', 'scui-fact');
+				exitFact.appendChild(el('span', 'scui-fact-key', TEXT.exitNode));
+				exitFact.appendChild(el('span', 'scui-fact-node', translateName(group.resolved)));
+				var rd = formatDelay(group.resolved_delay);
+				if (rd) {
+					exitFact.appendChild(delayPill(group.resolved_delay));
+				}
+				facts.appendChild(exitFact);
+			} else if (group.auto && group.members && group.members.length) {
+				// 自动组：额外标出最快的节点
+				var sortedAll = sortMembers(group.members);
+				if (sortedAll.length && toNumber(memberDelay(sortedAll[0])) !== null) {
+					facts.appendChild(el('span', 'scui-arrow', '·'));
+					var bestFact = el('span', 'scui-fact');
+					bestFact.appendChild(el('span', 'scui-fact-key', TEXT.fastest));
+					bestFact.appendChild(el('span', 'scui-fact-node', memberLabel(sortedAll[0])));
+					facts.appendChild(bestFact);
+				}
+			}
+			body.appendChild(facts);
+
+			// ---------- 节点列表
+			var members = sortMembers(group.members);
+			if (members.length) {
+				var nodes = el('div', 'scui-nodes');
+				var limit = (expanded || members.length <= COLLAPSE_AT) ? members.length : PREVIEW_N;
+
+				members.slice(0, limit).forEach(function(member) {
+					nodes.appendChild(buildNodeChip(group, member));
+				});
+
+				if (members.length > COLLAPSE_AT) {
+					var more = el('button', 'scui-btn scui-btn-ghost scui-nodes-toggle');
+					more.type = 'button';
+					if (expanded) {
+						more.appendChild(el('span', null, TEXT.showLess));
+					} else {
+						more.appendChild(el('span', null, tpl(TEXT.showAll, members.length)));
+					}
+					more.onclick = function() {
+						expandedGroups[group.name] = !expanded;
+						paint();
+					};
+					nodes.appendChild(more);
+				}
+				body.appendChild(nodes);
+			}
+
+			card.appendChild(body);
+			return card;
+		}
+
+		function buildNodeChip(group, member) {
+			var d = memberDelay(member);
+			var chip = el('span', 'scui-node ' + delayClass(d));
+			chip.title = TEXT.switchTo + ': ' + memberLabel(member);
+			if (member.name === group.now) {
+				chip.className += ' is-current';
+				chip.appendChild(icon('check'));
+			} else if (member.is_group) {
+				chip.appendChild(icon('group'));
+			}
+			chip.appendChild(el('span', 'scui-node-name', translateName(member.name)));
+			if (member.auto && member.leaf && member.leaf !== member.name) {
+				chip.appendChild(el('span', 'scui-node-leaf', '→ ' + translateName(member.leaf)));
+			}
+			chip.appendChild(el('span', 'scui-node-ms', formatDelay(d) || TEXT.timeout));
+
+			chip.onclick = function() {
+				if (member.name === group.now) {
+					return;
+				}
+				busy(TEXT.switching);
+				if (xhr && urls.switch) {
+					xhr.get(urls.switch, { sid: sid, group: group.name, name: member.name }, function(x, result) {
+						if (result && result.success) {
+							ok(TEXT.switched);
+							load();
+						} else {
+							err(TEXT.switchFail);
+						}
+					});
+				}
+			};
+			return chip;
+		}
+
+		function buildEmpty(text) {
+			var box = el('div', 'scui-empty');
+			box.appendChild(icon('inbox'));
+			box.appendChild(el('div', null, text || TEXT.emptyTitle));
+			return box;
+		}
+
+		// ---- 绘制
+		function paint() {
+			if (!mount) {
+				return;
+			}
+			mount.innerHTML = '';
+			if (!groups.length) {
+				mount.appendChild(buildEmpty(TEXT.noneFound));
+				return;
+			}
+
+			mount.appendChild(buildToolbar());
+
+			var needle = filterText.trim().toLowerCase();
+			var visible = needle ? groups.filter(function(group) {
+				return String(group.name).toLowerCase().indexOf(needle) >= 0;
+			}) : groups;
+
+			if (!visible.length) {
+				mount.appendChild(buildEmpty(TEXT.noneMatch));
+				return;
+			}
+
+			visible.forEach(function(group) {
+				mount.appendChild(buildCard(group));
+			});
+		}
+
+		// ---- 网络
+		function runDelayTest(groupName, done) {
+			if (testing || !sid) {
+				return;
+			}
+			testing = true;
+			busy(TEXT.testing);
+			xhr.get(urls.delayTest, { sid: sid, group: groupName, timeout: '5000' }, function(x, result) {
+				testing = false;
+				if (!result || !result.success) {
+					err(TEXT.testFailed);
+					if (done) { done(false); }
+					return;
+				}
+				if (done) { done(true, result.delays || {}); }
+			});
+		}
+
+		function testAll(list, btn) {
+			if (testing) {
+				return;
+			}
+			var queue = (list || []).slice();
+			var total = queue.length;
+			if (!total) {
+				return;
+			}
+			var index = 0;
+			if (btn) { btn.disabled = true; }
+
+			(function next() {
+				if (!queue.length) {
+					if (btn) { btn.disabled = false; }
+					ok();
+					load();
+					return;
+				}
+				index += 1;
+				var group = queue.shift();
+				busy(TEXT.testing + '  ' + index + ' / ' + total);
+				runDelayTest(group.name, function() {
+					window.setTimeout(next, 40);
+				});
+			})();
+		}
+
+		function load() {
+			if (!xhr || !urls.groups) {
+				return;
+			}
+			busy(TEXT.loading);
+			xhr.get(urls.groups, { sid: sid }, function(x, result) {
+				if (result && result.sid) {
+					sid = result.sid;
+				}
+				if (!result || !result.active) {
+					warn(TEXT.notActive);
+					groups = [];
+					mount.innerHTML = '';
+					mount.appendChild(buildEmpty(TEXT.notActive));
+					return;
+				}
+				testUrl = result.test_url || '';
+				testInterval = result.test_interval || '';
+				groups = result.groups || [];
+				ok();
+				paint();
+			});
+		}
+
+		return {
+			load: load,
+			setSid: function(value) { sid = value || ''; },
+			getSid: function() { return sid; },
+			status: setStatus,
+			ok: ok,
+			busy: busy,
+			warn: warn,
+			err: err,
+			reset: function() {
+				groups = [];
+				filterText = '';
+				expandedGroups = {};
+				if (mount) { mount.innerHTML = ''; }
+			}
+		};
+	}
+
+	return {
+		create: create,
+		formatDelay: formatDelay,
+		delayClass: delayClass,
+		translateName: translateName
+	};
