+# 把策略组的当前出口切到各自的自动组。
+# 映射表由 clash_yaml.lua 在生成运行时配置时一并写出（三列 TSV）。
+# 任何一步失败都只记日志，不影响已经起来的代理。
+# 用法：apply_clash_autoselect <sid>
+apply_clash_autoselect() {
+	local sid="$1"
+	local workdir
+	local map_file
+	local secret
+	local done=0
+	local failed=0
+	local wait=0
+	local enc_group
+	local enc_target
+	local target
+	local body
+
+	[ -n "$sid" ] || return 0
+	workdir="$(get_clash_workdir "$sid")"
+	map_file="$workdir/autoselect.map"
+	[ -s "$map_file" ] || return 0
+
+	if ! command -v curl >/dev/null 2>&1; then
+		echolog "自动切换：缺少 curl，跳过（可在策略组面板里手动选择自动组）。"
+		return 0
+	fi
+
+	secret="$(get_clash_api_secret "$sid")"
+
+	# 等 mihomo 的 external-controller 就绪
+	while [ "$wait" -lt 20 ]; do
+		if curl -s -o /dev/null -m 2 </dev/null -H "Authorization: Bearer $secret" "http://127.0.0.1:$CLASH_API_PORT/version"; then
+			break
+		fi
+		wait=$((wait + 1))
+		sleep 1
+	done
+	if [ "$wait" -ge 20 ]; then
+		echolog "自动切换：等待 Mihomo API 就绪超时，本次跳过。"
+		return 0
+	fi
+
+	while IFS="$(printf '\t')" read -r enc_group enc_target target; do
+		[ -n "$enc_group" ] && [ -n "$target" ] || continue
+		body="{\"name\":\"$(printf '%s' "$target" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')\"}"
+		if curl -s -o /dev/null -m 5 </dev/null -X PUT \
+			-H "Authorization: Bearer $secret" \
+			-H "Content-Type: application/json" \
+			-d "$body" \
+			"http://127.0.0.1:$CLASH_API_PORT/proxies/$enc_group"; then
+			done=$((done + 1))
+		else
+			failed=$((failed + 1))
+		fi
+	done < "$map_file"
+
+	if [ "$done" -gt 0 ]; then
+		echolog "自动切换：已把 $done 个选择器切到自动组，之后由 Mihomo 按延迟自动挑节点。"
+	fi
+	if [ "$failed" -gt 0 ]; then
+		echolog "自动切换：$failed 个选择器切换失败，可在策略组面板里手动选择。"
+	fi
+	return 0
+}
