+-- 会自己挑节点的组类型：它们的 now 就是"自动选择的结果"
+local AUTO_SELECT_TYPES = {
+	["url-test"] = true,
+	["fallback"] = true,
+	["load-balance"] = true,
+	["relay"] = true,
+	["smart"] = true
+}
+
+-- mihomo 的 /proxies 里每个代理都有 history:[{time, delay}]，取最后一条作为"最近一次测速延迟"
+local function proxy_last_delay(proxy)
+	if type(proxy) ~= "table" then
+		return nil
+	end
+	local history = proxy.history
+	if type(history) == "table" and #history > 0 then
+		local last = history[#history]
+		if type(last) == "table" then
+			local delay = tonumber(last.delay)
+			-- mihomo 用 0 表示超时/不可用
+			if delay and delay > 0 then
+				return delay
+			end
+		end
+	end
+	return nil
+end
+
+local function clash_proxy_map(active_sid)
+	local raw = clash_api_request(active_sid, "GET", "/proxies")
+	if not raw or not raw.body or raw.body == "" then
+		return nil
+	end
+	local info = json.parse(raw.body)
+	if type(info) ~= "table" or type(info.proxies) ~= "table" then
+		return nil
+	end
+	return info.proxies
+end
+
+-- 顺着 now 一路往下追，找出流量最终落到哪个真实节点（DIRECT/REJECT 也算终点）
+local function resolve_clash_leaf(proxies, name, depth)
+	depth = depth or 0
+	if not name or name == "" or depth > 8 then
+		return nil
+	end
+	local proxy = proxies[name]
+	if type(proxy) ~= "table" then
+		return name
+	end
+	local now = proxy.now
+	if type(proxy.all) == "table" and #proxy.all > 0 and type(now) == "string"
+		and now ~= "" and now ~= name then
+		return resolve_clash_leaf(proxies, now, depth + 1) or now
+	end
+	return name
+end
+
+-- 在 parse_clash_groups 的基础上补充：成员延迟、自动选择结果、最终落地节点
+local function build_clash_group_view(proxies)
+	local groups = {}
+	if type(proxies) ~= "table" then
+		return groups
+	end
+	for name, proxy in pairs(proxies) do
+		if type(proxy) == "table" and type(proxy.all) == "table" and #proxy.all > 0 then
+			local members = {}
+			for _, member in ipairs(proxy.all) do
+				local mp = proxies[member]
+				local leaf = resolve_clash_leaf(proxies, member, 0)
+				members[#members + 1] = {
+					name = member,
+					type = (type(mp) == "table" and mp.type) or "",
+					delay = proxy_last_delay(mp),
+					-- 成员本身是组时，它的"实际出口"
+					leaf = leaf,
+					leaf_delay = proxy_last_delay(proxies[leaf or ""]),
+					is_group = type(mp) == "table" and type(mp.all) == "table" and #mp.all > 0,
+					auto = AUTO_SELECT_TYPES[tostring((type(mp) == "table" and mp.type) or "")] == true
+				}
+			end
+			table.sort(members, function(a, b) return tostring(a.name) < tostring(b.name) end)
+
+			local now = proxy.now or ""
+			local leaf = resolve_clash_leaf(proxies, now ~= "" and now or name, 0)
+			groups[#groups + 1] = {
+				name = name,
+				type = proxy.type or "",
+				now = now,
+				all = proxy.all,
+				members = members,
+				-- 自动选择/手动选择的最终结果（真实节点）
+				resolved = leaf,
+				resolved_delay = proxy_last_delay(proxies[leaf or ""]),
+				delay = proxy_last_delay(proxy) or proxy_last_delay(proxies[leaf or ""]),
+				auto = AUTO_SELECT_TYPES[tostring(proxy.type or "")] == true
+			}
+		end
+	end
+	table.sort(groups, function(a, b) return tostring(a.name) < tostring(b.name) end)
+	return groups
+end
+
+-- url-test 用的测速地址：mihomo_urltest_url > url_test_url > 内置默认
