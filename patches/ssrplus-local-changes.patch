+-- 对某个代理组做一次整组测速（GET /group/<name>/delay），返回每个成员的延迟
+function clash_delay_test()
+	local sid = luci.http.formvalue("sid")
+	local group = luci.http.formvalue("group")
+	if not group or group == "" then
+		luci.http.status(400, "Bad Request")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({success = false, message = "missing group"})
+		return
+	end
+
+	local active_sid = resolve_active_clash_sid(sid)
+	if not active_sid then
+		luci.http.status(409, "Conflict")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({success = false, message = "inactive"})
+		return
+	end
+
+	local timeout = tonumber(luci.http.formvalue("timeout")) or 5000
+	if timeout < 500 then timeout = 500 end
+	if timeout > 15000 then timeout = 15000 end
+	local url = get_urltest_url()
+	local path = string.format("/group/%s/delay?url=%s&timeout=%d",
+		urlencode(group), urlencode(url), timeout)
+
+	-- 整组测速是并发的，但最坏情况仍可能等满 timeout，curl 多留 10s 余量
+	local ret = clash_api_request(active_sid, "GET", path, nil, math.ceil(timeout / 1000) + 10)
+	local ok = ret ~= nil and ret.code ~= nil and ret.code >= 200 and ret.code < 300
+	local delays = {}
+	if ok then
+		local parsed = json.parse(ret.body or "")
+		if type(parsed) == "table" then
+			for name, delay in pairs(parsed) do
+				local value = tonumber(delay)
+				-- mihomo 用 0 表示超时/不可用，转成 false 让前端显示"超时"
+				delays[name] = (value and value > 0) and value or false
+			end
+		end
+	end
+
+	luci.http.prepare_content("application/json")
+	luci.http.write_json({
+		success = ok,
+		group = group,
+		delays = delays,
+		url = url,
+		timeout = timeout,
+		code = ret and ret.code or nil
 	})
 end
 
