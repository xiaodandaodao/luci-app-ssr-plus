+			testBtn.title = TEXT.speedTest;
+			testBtn.appendChild(icon('bolt'));
+			testBtn.appendChild(el('span', null, TEXT.speedTest));
+			testBtn.onclick = function() {
+				testBtn.disabled = true;
+				var ic = testBtn.querySelector('.scui-icon');
+				if (ic) { ic.style.animation = 'scui-spin 0.9s linear infinite'; }
+				runDelayTest(group.name, function(success) {
+					testBtn.disabled = false;
+					if (ic) { ic.style.animation = ''; }
+					if (success) {
+						ok();
+						load();
+					}
+				});
+			};
+			headR.appendChild(testBtn);
+			head.appendChild(headR);
+			card.appendChild(head);
+
+			// ---------- 主体
+			var body = el('div', 'scui-card-body');
+
+			var select = el('select', 'scui-select');
+			(group.all || []).forEach(function(name) {
+				var option = document.createElement('option');
+				option.value = name;
+				var member = findMember(group, name);
+				var label = translateName(name);
+				var d = formatDelay(memberDelay(member));
+				option.textContent = d ? (label + '  ·  ' + d) : label;
+				if (name === group.now) {
+					option.selected = true;
+				}
+				select.appendChild(option);
+			});
+			select.onchange = function() {
+				busy(TEXT.switching);
+				if (xhr && urls.switch) {
+					xhr.get(urls.switch, { sid: sid, group: group.name, name: select.value }, function(x, result) {
+						if (result && result.success) {
+							ok(TEXT.switched);
+							load();
+						} else {
+							err(TEXT.switchFail);
+							select.value = group.now || select.value;
+						}
+					});
+				}
+			};
+			body.appendChild(select);
+
+			// 当前 / 实际出口
+			var facts = el('div', 'scui-facts');
+			var curFact = el('span', 'scui-fact');
+			curFact.appendChild(el('span', 'scui-fact-key', (group.auto ? TEXT.autoSel : TEXT.current)));
+			curFact.appendChild(el('span', 'scui-fact-node', translateName(group.now || '—')));
+			if (nowDelay) {
+				curFact.appendChild(delayPill(nowDelay));
+			}
+			facts.appendChild(curFact);
+
+			if (group.resolved && group.resolved !== group.now) {
+				facts.appendChild(el('span', 'scui-arrow', '→'));
+				var exitFact = el('span', 'scui-fact');
+				exitFact.appendChild(el('span', 'scui-fact-key', TEXT.exitNode));
+				exitFact.appendChild(el('span', 'scui-fact-node', translateName(group.resolved)));
+				var rd = formatDelay(group.resolved_delay);
+				if (rd) {
+					exitFact.appendChild(delayPill(group.resolved_delay));
+				}
+				facts.appendChild(exitFact);
+			} else if (group.auto && group.members && group.members.length) {
+				// 自动组：额外标出最快的节点
+				var sortedAll = sortMembers(group.members);
+				if (sortedAll.length && toNumber(memberDelay(sortedAll[0])) !== null) {
+					facts.appendChild(el('span', 'scui-arrow', '·'));
+					var bestFact = el('span', 'scui-fact');
+					bestFact.appendChild(el('span', 'scui-fact-key', TEXT.fastest));
+					bestFact.appendChild(el('span', 'scui-fact-node', memberLabel(sortedAll[0])));
+					facts.appendChild(bestFact);
+				}
+			}
+			body.appendChild(facts);
+
+			// ---------- 节点列表
+			var members = sortMembers(group.members);
+			if (members.length) {
+				var nodes = el('div', 'scui-nodes');
+				var limit = (expanded || members.length <= COLLAPSE_AT) ? members.length : PREVIEW_N;
+
+				members.slice(0, limit).forEach(function(member) {
+					nodes.appendChild(buildNodeChip(group, member));
+				});
+
+				if (members.length > COLLAPSE_AT) {
+					var more = el('button', 'scui-btn scui-btn-ghost scui-nodes-toggle');
+					more.type = 'button';
+					if (expanded) {
+						more.appendChild(el('span', null, TEXT.showLess));
+					} else {
+						more.appendChild(el('span', null, tpl(TEXT.showAll, members.length)));
+					}
+					more.onclick = function() {
+						expandedGroups[group.name] = !expanded;
+						paint();
+					};
+					nodes.appendChild(more);
+				}
+				body.appendChild(nodes);
+			}
+
+			card.appendChild(body);
+			return card;
+		}
+
+		function buildNodeChip(group, member) {
+			var d = memberDelay(member);
+			var chip = el('span', 'scui-node ' + delayClass(d));
+			chip.title = TEXT.switchTo + ': ' + memberLabel(member);
+			if (member.name === group.now) {
+				chip.className += ' is-current';
+				chip.appendChild(icon('check'));
+			} else if (member.is_group) {
+				chip.appendChild(icon('group'));
+			}
+			chip.appendChild(el('span', 'scui-node-name', translateName(member.name)));
+			if (member.auto && member.leaf && member.leaf !== member.name) {
+				chip.appendChild(el('span', 'scui-node-leaf', '→ ' + translateName(member.leaf)));
+			}
+			chip.appendChild(el('span', 'scui-node-ms', formatDelay(d) || TEXT.timeout));
+
+			chip.onclick = function() {
+				if (member.name === group.now) {
+					return;
+				}
+				busy(TEXT.switching);
+				if (xhr && urls.switch) {
+					xhr.get(urls.switch, { sid: sid, group: group.name, name: member.name }, function(x, result) {
+						if (result && result.success) {
+							ok(TEXT.switched);
+							load();
+						} else {
+							err(TEXT.switchFail);
+						}
+					});
+				}
+			};
+			return chip;
+		}
+
+		function buildEmpty(text) {
+			var box = el('div', 'scui-empty');
+			box.appendChild(icon('inbox'));
+			box.appendChild(el('div', null, text || TEXT.emptyTitle));
+			return box;
+		}
+
+		// ---- 绘制
+		function paint() {
+			if (!mount) {
+				return;
+			}
+			mount.innerHTML = '';
+			if (!groups.length) {
+				mount.appendChild(buildEmpty(TEXT.noneFound));
+				return;
+			}
+
+			mount.appendChild(buildToolbar());
+
+			var needle = filterText.trim().toLowerCase();
+			var visible = needle ? groups.filter(function(group) {
+				return String(group.name).toLowerCase().indexOf(needle) >= 0;
+			}) : groups;
+
+			if (!visible.length) {
+				mount.appendChild(buildEmpty(TEXT.noneMatch));
+				return;
+			}
+
+			visible.forEach(function(group) {
+				mount.appendChild(buildCard(group));
+			});
+		}
+
+		// ---- 网络
+		function runDelayTest(groupName, done) {
+			if (testing || !sid) {
+				return;
+			}
+			testing = true;
+			busy(TEXT.testing);
+			xhr.get(urls.delayTest, { sid: sid, group: groupName, timeout: '5000' }, function(x, result) {
+				testing = false;
+				if (!result || !result.success) {
+					err(TEXT.testFailed);
+					if (done) { done(false); }
+					return;
+				}
+				if (done) { done(true, result.delays || {}); }
+			});
+		}
+
+		function testAll(list, btn) {
+			if (testing) {
+				return;
+			}
+			var queue = (list || []).slice();
+			var total = queue.length;
+			if (!total) {
+				return;
+			}
+			var index = 0;
+			if (btn) { btn.disabled = true; }
+
+			(function next() {
+				if (!queue.length) {
+					if (btn) { btn.disabled = false; }
+					ok();
+					load();
+					return;
+				}
+				index += 1;
+				var group = queue.shift();
+				busy(TEXT.testing + '  ' + index + ' / ' + total);
+				runDelayTest(group.name, function() {
+					window.setTimeout(next, 40);
+				});
+			})();
+		}
+
+		function load() {
+			if (!xhr || !urls.groups) {
+				return;
+			}
+			busy(TEXT.loading);
+			xhr.get(urls.groups, { sid: sid }, function(x, result) {
+				if (result && result.sid) {
+					sid = result.sid;
+				}
+				if (!result || !result.active) {
+					warn(TEXT.notActive);
+					groups = [];
+					mount.innerHTML = '';
+					mount.appendChild(buildEmpty(TEXT.notActive));
+					return;
+				}
+				testUrl = result.test_url || '';
+				testInterval = result.test_interval || '';
+				groups = result.groups || [];
+				ok();
+				paint();
+			});
+		}
+
+		return {
+			load: load,
+			setSid: function(value) { sid = value || ''; },
+			getSid: function() { return sid; },
+			status: setStatus,
+			ok: ok,
+			busy: busy,
+			warn: warn,
+			err: err,
+			reset: function() {
+				groups = [];
+				filterText = '';
+				expandedGroups = {};
+				if (mount) { mount.innerHTML = ''; }
+			}
+		};
+	}
+
+	return {
+		create: create,
+		formatDelay: formatDelay,
+		delayClass: delayClass,
+		translateName: translateName
+	};
+})();
+</script>
