+-- 对某个代理组做一次整组测速（GET /group/<name>/delay），返回每个成员的延迟
+function clash_delay_test()
+	local sid = luci.http.formvalue("sid")
+	local group = luci.http.formvalue("group")
+	if not group or group == "" then
+		luci.http.status(400, "Bad Request")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({success = false, message = "missing group"})
+		return
+	end
+
+	local active_sid = resolve_active_clash_sid(sid)
+	if not active_sid then
+		luci.http.status(409, "Conflict")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({success = false, message = "inactive"})
+		return
+	end
+
+	local timeout = tonumber(luci.http.formvalue("timeout")) or 5000
+	if timeout < 500 then timeout = 500 end
+	if timeout > 15000 then timeout = 15000 end
+	local url = get_urltest_url()
+	local path = string.format("/group/%s/delay?url=%s&timeout=%d",
+		urlencode(group), urlencode(url), timeout)
+
+	-- 整组测速是并发的，但最坏情况仍可能等满 timeout，curl 多留 10s 余量
+	local ret = clash_api_request(active_sid, "GET", path, nil, math.ceil(timeout / 1000) + 10)
+	local ok = ret ~= nil and ret.code ~= nil and ret.code >= 200 and ret.code < 300
+	local delays = {}
+	if ok then
+		local parsed = json.parse(ret.body or "")
+		if type(parsed) == "table" then
+			for name, delay in pairs(parsed) do
+				local value = tonumber(delay)
+				-- mihomo 用 0 表示超时/不可用，转成 false 让前端显示"超时"
+				delays[name] = (value and value > 0) and value or false
+			end
+		end
+	end
+
+	luci.http.prepare_content("application/json")
+	luci.http.write_json({
+		success = ok,
+		group = group,
+		delays = delays,
+		url = url,
+		timeout = timeout,
+		code = ret and ret.code or nil
+	})
+end
+
+-- ---------------------------------------------------------------------------
+-- 自定义分组（uci: config custom_group）
+--
+-- 面板里手动建一个分组、勾选若干节点；生成运行时 YAML 时（clash_yaml.lua
+-- inject_smart_groups）会为它生成一个代理组，并把组名插进各分流组的节点列表。
+-- ---------------------------------------------------------------------------
+
+-- 会自己挑节点的组类型，用于把「组」和「真实节点」区分开
+local PROXY_GROUP_TYPES = {
+	selector = true,
+	["url-test"] = true,
+	fallback = true,
+	["load-balance"] = true,
+	relay = true,
+	compatible = true,
+	pass = true
+}
+
+-- 从 /proxies 结果里挑出真实节点名
+local function clash_node_names(proxies)
+	local names = {}
+	for name, proxy in pairs(proxies or {}) do
+		if type(proxy) == "table" then
+			local ptype = tostring(proxy.type or ""):lower()
+			local is_group = type(proxy.all) == "table" and #proxy.all > 0
+			if not is_group
+				and not PROXY_GROUP_TYPES[ptype]
+				and ptype ~= "direct" and ptype ~= "reject" and ptype ~= "rejectdrop"
+			then
+				names[#names + 1] = tostring(name)
+			end
+		end
+	end
+	table.sort(names, function(a, b) return a < b end)
+	return names
+end
+
+local function split_node_list(value)
+	local nodes = {}
+	for part in tostring(value or ""):gmatch("[^,]+") do
+		local node = trim(part)
+		if node ~= "" then
+			nodes[#nodes + 1] = node
+		end
+	end
+	return nodes
+end
+
+local function read_custom_groups()
+	local list = {}
+	local all = uci:get_all("shadowsocksr") or {}
+	for key, section in pairs(all) do
+		if type(section) == "table" and tostring(section[".type"] or "") == "custom_group" then
+			local name = trim(section.name)
+			if name ~= "" then
+				list[#list + 1] = {
+					id = key,
+					name = name,
+					nodes = split_node_list(section.nodes),
+					mode = (tostring(section.mode or "auto") == "manual") and "manual" or "auto",
+					enabled = tostring(section.enabled or "1") ~= "0"
+				}
+			end
+		end
+	end
+	table.sort(list, function(a, b) return tostring(a.name) < tostring(b.name) end)
+	return list
+end
+
+-- 改完分组后重新生成并应用运行时配置（仅当当前生效的节点是本 Clash 节点时）
+local function reapply_active_clash()
+	local current_sid = uci:get_first("shadowsocksr", "global", "global_server")
+	if not current_sid or current_sid == "" then
+		return false
+	end
+	if uci:get("shadowsocksr", current_sid) ~= "servers"
+		or uci:get("shadowsocksr", current_sid, "type") ~= "clash"
+	then
+		return false
+	end
+	luci.sys.call("/etc/init.d/shadowsocksr restart >/dev/null 2>&1 &")
+	return true
+end
+
+function clash_custom_groups()
+	local sid = luci.http.formvalue("sid")
+	local active_sid = resolve_active_clash_sid(sid)
+	local nodes = {}
+	if active_sid then
+		local proxies = clash_proxy_map(active_sid)
+		if proxies then
+			nodes = clash_node_names(proxies)
+		end
+	end
+
+	luci.http.prepare_content("application/json")
+	luci.http.write_json({
+		active = active_sid ~= nil,
+		sid = active_sid,
+		groups = read_custom_groups(),
+		-- 可挑选的真实节点（节点未生效时为空）
+		nodes = nodes,
+		auto_regions = uci:get_first("shadowsocksr", "server_subscribe", "mihomo_auto_regions") or "1",
+		auto_regions_min = uci:get_first("shadowsocksr", "server_subscribe", "mihomo_auto_regions_min") or "2",
+		urltest_enabled = uci:get_first("shadowsocksr", "server_subscribe", "mihomo_urltest") or "0"
+	})
+end
+
+function clash_custom_group_save()
+	local id = trim(luci.http.formvalue("id"))
+	local name = trim(luci.http.formvalue("name"))
+	local mode = trim(luci.http.formvalue("mode"))
+	local enabled = tostring(luci.http.formvalue("enabled") or "1") == "1" and "1" or "0"
+	local count = tonumber(luci.http.formvalue("node_count") or "0") or 0
+
+	if name == "" or #name > 60 then
+		luci.http.status(400, "Bad Request")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({ success = false, error = "invalid_name" })
+		return
+	end
+
+	local nodes = {}
+	local seen = {}
+	for index = 1, math.min(count, 4096) do
+		local node = trim(luci.http.formvalue("node_" .. index))
+		if node ~= "" and node:find(",", 1, true) == nil and not seen[node] then
+			seen[node] = true
+			nodes[#nodes + 1] = node
+		end
+	end
+
+	local cursor = require("luci.model.uci").cursor()
+	if id ~= "" and cursor:get("shadowsocksr", id) ~= "custom_group" then
+		id = ""
+	end
+	local target = id
+	if target == "" then
+		target = cursor:add("shadowsocksr", "custom_group")
+	end
+	if not target then
+		luci.http.status(500, "Internal Server Error")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({ success = false, error = "uci_add_failed" })
+		return
+	end
+
+	cursor:set("shadowsocksr", target, "name", name)
+	cursor:set("shadowsocksr", target, "nodes", table.concat(nodes, ","))
+	cursor:set("shadowsocksr", target, "mode", (mode == "manual") and "manual" or "auto")
+	cursor:set("shadowsocksr", target, "enabled", enabled)
+	cursor:commit("shadowsocksr")
+
+	luci.http.prepare_content("application/json")
+	luci.http.write_json({
+		success = true,
+		id = target,
+		reapplied = reapply_active_clash(),
+		groups = read_custom_groups()
+	})
+end
+
+function clash_custom_group_delete()
+	local id = trim(luci.http.formvalue("id"))
+	if id == "" or uci:get("shadowsocksr", id) ~= "custom_group" then
+		luci.http.status(400, "Bad Request")
+		luci.http.prepare_content("application/json")
+		luci.http.write_json({ success = false, error = "invalid_id" })
+		return
+	end
+
+	local cursor = require("luci.model.uci").cursor()
+	cursor:delete("shadowsocksr", id)
+	cursor:commit("shadowsocksr")
+
+	luci.http.prepare_content("application/json")
+	luci.http.write_json({
+		success = true,
+		reapplied = reapply_active_clash(),
+		groups = read_custom_groups()
 	})
 end
 
